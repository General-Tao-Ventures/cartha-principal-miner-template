# ── Required ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/principal_rewards
VERIFIER_URL=https://api.cartha.finance

# ── Identity (synced to verifier on startup — shown on cartha.finance) ──
# Leave blank to keep existing values on the verifier.
MINER_NAME=My Mining Operation
MINER_DESCRIPTION=High-performance Cartha principal miner
MINER_WEBSITE=
MINER_DISCORD=
MINER_LOGO_URL=

# ── Terms (synced to verifier on startup — shown on cartha.finance) ─────
# Leave blank / unset to keep existing values on the verifier.
PAYOUT_SCHEDULE=per_epoch
MIN_LOCK_DAYS=30
MIN_LOCK_AMOUNT_USDC=100
TERMS_TEXT=
ACCEPTS_NEW_MINERS=true

# ── Commission & Rewards ─────────────────────────────────────
COMMISSION_RATE=0.05
HOME_EVM_ADDRESSES=["0xYourAddress"]
MIN_CLAIM_ALPHA=0.001

# ── Bittensor (required) ──────────────────────────────────────
MINER_HOTKEY=
MINER_COLDKEY=
MINER_SLOT=0
AGGREGATOR_HOTKEY=
BT_WALLET_NAME=default
BT_NETWORK=finney
WALLET_PASSWORD=

# ── Optional ──────────────────────────────────────────────────
# GCP_SECRET_ID=
# GCP_PROJECT=
# SLACK_WEBHOOK_URL=
# SLACK_ERROR_WEBHOOK_URL=
# ADMIN_API_KEY=
# CORS_ORIGINS=["https://app.cartha.finance"]
# CLAIM_COOLDOWN_SECONDS=60
# POLL_INTERVAL=30
