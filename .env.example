# ── Required ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/principal_rewards
VERIFIER_URL=https://api.cartha.finance

# ── Identity (shown on frontend) ─────────────────────────────
MINER_NAME=My Mining Operation
MINER_DESCRIPTION=High-performance Cartha principal miner
MINER_WEBSITE=
MINER_DISCORD=
MINER_LOGO_URL=

# ── Commission & Rewards ─────────────────────────────────────
COMMISSION_RATE=0.05
HOME_EVM_ADDRESSES=["0xYourAddress"]
MIN_CLAIM_ALPHA=0.001

# ── Bittensor (required) ──────────────────────────────────────
MINER_HOTKEY=
MINER_COLDKEY=
AGGREGATOR_HOTKEY=
BT_WALLET_NAME=default
BT_NETWORK=finney
WALLET_PASSWORD=

# ── Optional ──────────────────────────────────────────────────
# GCP_SECRET_ID=
# GCP_PROJECT=
# SLACK_WEBHOOK_URL=
# SLACK_ERROR_WEBHOOK_URL=
# ADMIN_API_KEY=
